{
  "manifest_version": 3,
  "name": "Stashd",
  "version": "1.3",
  "description": "Lets Stashd keep a folder's tabs together in a named tab group, and know when you've finished a video.",
  "key": "",
  "permissions": [
    "tabGroups",
    "tabs",
    "storage"
  ],
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.disneyplus.com/*",
        "https://www.twitch.tv/*",
        "https://www.crunchyroll.com/*",
        "https://tv.apple.com/*"
      ],
      "js": [
        "progress.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
