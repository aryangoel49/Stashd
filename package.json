{
  "name": "where-was-i",
  "productName": "Where Was I",
  "version": "1.0.0",
  "private": true,
  "description": "Saves where you were in a project and helps you pick up again.",
  "keywords": [],
  "license": "MIT",
  "author": "aryangoel",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "native": "mkdir -p native/build && xcrun swiftc -O -swift-version 5 native/wwi-helper.swift -o native/build/wwi-helper",
    "prestart": "npm run native",
    "prepackage": "npm run native",
    "premake": "npm run native"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.9.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "bin": {
    "where-was-i": "bin/where-was-i.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "fs-xattr@0.3.1": true,
    "fsevents@2.3.3": true,
    "macos-alias@0.2.12": true
  }
}
