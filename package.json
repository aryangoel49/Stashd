{
  "name": "stashd",
  "productName": "Stashd",
  "version": "1.3.36",
  "private": true,
  "description": "Stashes where you were in a project and helps you pick up again.",
  "keywords": [],
  "license": "MIT",
  "author": "aryangoel",
  "homepage": "https://github.com/aryangoel49/Stashd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryangoel49/Stashd.git"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "install-local": "bash scripts/install-local.sh",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "native": "mkdir -p native/build && xcrun swiftc -O -swift-version 5 native/wwi-helper.swift -o native/build/wwi-helper",
    "embedder": "node scripts/prepare-embedder.mjs",
    "prestart": "npm run native && npm run embedder",
    "prepackage": "npm run native && npm run embedder",
    "premake": "npm run native && npm run embedder"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.9.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "bin": {
    "stashd": "bin/stashd.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.23.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "allowScripts": {
    "fs-xattr@0.3.1": true,
    "fsevents@2.3.3": true,
    "macos-alias@0.2.12": true
  }
}
